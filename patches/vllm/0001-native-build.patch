new file mode 100644
--- /dev/null
+++ b/cmake/windows_arm64_cuda.cmake
@@ -0,0 +1,34 @@
+# FindCUDA still searches lib/x64 first on Windows. Seed both the legacy
+# FindCUDA and current FindCUDAToolkit variables before Torch imports them.
+if(NOT DEFINED ENV{CUDA_PATH})
+  message(FATAL_ERROR "Native ARM64 CUDA builds require CUDA_PATH")
+endif()
+file(TO_CMAKE_PATH "$ENV{CUDA_PATH}" _arm64_cuda_root)
+set(_arm64_cuda_lib "${_arm64_cuda_root}/lib/arm64")
+foreach(_required cudart cuda cublas cublasLt nvrtc)
+  if(NOT EXISTS "${_arm64_cuda_lib}/${_required}.lib")
+    message(FATAL_ERROR "Missing ARM64 CUDA import library: ${_required}.lib")
+  endif()
+endforeach()
+file(GLOB _arm64_cuda_libraries "${_arm64_cuda_lib}/*.lib")
+foreach(_library IN LISTS _arm64_cuda_libraries)
+  get_filename_component(_name "${_library}" NAME_WE)
+  set(CUDA_${_name}_LIBRARY "${_library}" CACHE FILEPATH "ARM64 CUDA library" FORCE)
+endforeach()
+set(CUDA_CUDART_LIBRARY "${_arm64_cuda_lib}/cudart.lib" CACHE FILEPATH "ARM64 CUDA runtime" FORCE)
+set(CUDA_CUDART "${_arm64_cuda_lib}/cudart.lib" CACHE FILEPATH "ARM64 CUDA runtime" FORCE)
+set(CUDART_LIBRARY "${_arm64_cuda_lib}/cudart.lib" CACHE FILEPATH "ARM64 CUDA runtime" FORCE)
+set(CUDA_CUDA_LIBRARY "${_arm64_cuda_lib}/cuda.lib" CACHE FILEPATH "ARM64 CUDA driver" FORCE)
+set(CUDA_DRIVER_LIBRARY "${_arm64_cuda_lib}/cuda.lib" CACHE FILEPATH "ARM64 CUDA driver" FORCE)
+set(CUDA_cuda_driver_LIBRARY "${_arm64_cuda_lib}/cuda.lib" CACHE FILEPATH "ARM64 CUDA driver" FORCE)
+set(CUDA_NVRTC_LIB "${_arm64_cuda_lib}/nvrtc.lib" CACHE FILEPATH "ARM64 NVRTC" FORCE)
+set(NVRTC_LIBRARY "${_arm64_cuda_lib}/nvrtc.lib" CACHE FILEPATH "ARM64 CUTLASS NVRTC" FORCE)
+set(_CUBLAS_LIBRARY "${_arm64_cuda_lib}/cublas.lib" CACHE FILEPATH "ARM64 CUTLASS cuBLAS" FORCE)
+set(_CUBLASLT_LIBRARY "${_arm64_cuda_lib}/cublasLt.lib" CACHE FILEPATH "ARM64 CUTLASS cuBLASLt" FORCE)
+set(CUDA_NVRTC_SHORTHASH "" CACHE STRING "Recompute native NVRTC hash" FORCE)
+set(CUDA_TOOLKIT_ROOT_DIR "${_arm64_cuda_root}" CACHE PATH "Native CUDA Toolkit" FORCE)
+set(CUDA_TOOLKIT_ROOT_DIR_INTERNAL "${_arm64_cuda_root}" CACHE INTERNAL "Native CUDA Toolkit" FORCE)
+set(CUDA_TOOLKIT_TARGET_DIR "${_arm64_cuda_root}" CACHE PATH "Native CUDA Toolkit target" FORCE)
+set(CUDA_TOOLKIT_TARGET_DIR_INTERNAL "${_arm64_cuda_root}" CACHE INTERNAL "Native CUDA Toolkit target" FORCE)
+set(CUDAToolkit_ROOT "${_arm64_cuda_root}" CACHE PATH "Native CUDA Toolkit" FORCE)
+message(STATUS "Using Windows ARM64 CUDA import libraries: ${_arm64_cuda_lib}")
