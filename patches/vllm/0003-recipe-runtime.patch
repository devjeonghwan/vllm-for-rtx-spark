+_MbxDLDeleter = _mbx_ct.CFUNCTYPE(None, _mbx_ct.POINTER(_MbxDLManagedTensor))
+_MbxDLManagedTensor._fields_ = [("dl_tensor", _MbxDLTensor), ("manager_ctx", _mbx_ct.c_void_p),
+                                ("deleter", _MbxDLDeleter)]
