+    if mode == "1":
+        _mbx_mmap_populate(T, "at load")
+    elif mode == "auto":
+        _mbx_hook_warmup_populate()
+    delay = int(mode) if mode.isdigit() and int(mode) > 1 else None
+
+    def _watch():
