diff --git a/cmake/patches/apply_windows_kernel_patch.cmake b/cmake/patches/apply_windows_kernel_patch.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/patches/apply_windows_kernel_patch.cmake
@@ -0,0 +1,19 @@
+# Run after dependency population and before its sources are consumed.
+cmake_minimum_required(VERSION 3.26)
+find_package(Git REQUIRED)
+if(NOT EXISTS "${SOURCE_DIR}/.git" OR NOT EXISTS "${PATCH_FILE}")
+  message(FATAL_ERROR "Missing dependency source or patch")
+endif()
+execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.autocrlf=false -c core.eol=lf apply --reverse --check --ignore-whitespace "${PATCH_FILE}"
+  WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE _already
+  OUTPUT_QUIET ERROR_QUIET)
+if(NOT _already EQUAL 0)
+  execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.autocrlf=false -c core.eol=lf apply --check --ignore-whitespace "${PATCH_FILE}"
+    WORKING_DIRECTORY "${SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
+  execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.autocrlf=false -c core.eol=lf apply --ignore-whitespace "${PATCH_FILE}"
+    WORKING_DIRECTORY "${SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
+endif()
+if(DEFINED CUTLASS_FIX)
+  execute_process(COMMAND "${PYTHON_EXECUTABLE}" "${CUTLASS_FIX}" "${SOURCE_DIR}/csrc/cutlass"
+    COMMAND_ERROR_IS_FATAL ANY)
+endif()
