+#if !defined(MINIMAX_MSA_Q8KV4_BLOCK_SCALE_SHIFT)
+#error "The Q8KV4 JIT must define MINIMAX_MSA_Q8KV4_BLOCK_SCALE_SHIFT"
+#endif
