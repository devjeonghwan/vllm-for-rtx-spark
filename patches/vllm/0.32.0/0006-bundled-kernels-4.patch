+static tvm::ffi::Tensor optional_to_tvm(const std::optional<at::Tensor> &t) {
+  if (!t.has_value() || !t->defined())
+    return tvm::ffi::Tensor(nullptr);
+  return torch_to_tvm(*t);
+}
