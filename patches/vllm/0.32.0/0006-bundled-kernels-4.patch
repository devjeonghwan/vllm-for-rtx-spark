+            tdVtdV0 = cute.make_tensor(tmem_ptr + self.tmem_offset_dV0, tdVtdV0_fake.layout)
+            tdVtdV1 = cute.make_tensor(tmem_ptr + self.tmem_offset_dV1, tdVtdV1_fake.layout)
+            self.mma(
+                sV,
+                sdO,
+                sPt,
+                sdOt,
+                sdSt,
+                sQvt,
+                tdPtdP,
+                tdVtdV0,
+                tdVtdV1,
+                tiled_mma_VdO,
+                tiled_mma_PtdOt,
