+@dsl_user_op
+def cvt_bf16x2_ue8m0x2(a: cutlass.Int16, *, loc=None, ip=None) -> cutlass.Int32:
+    """
+    cvt.rn.bf16x2.ue8m0x2  d, a;
+
+    Converts a packed ue8m0x2 value (two UE8M0 block-scale exponents in a
+    16-bit register) to a packed bf16x2 (two BF16s in a 32-bit register).
+
+    rn = round-to-nearest-even (only rounding mode supported for this direction).
+    No .satfinite needed — UE8M0 values always map to representable BF16s.
+    """
+    return cutlass.Int32(
+        llvm.inline_asm(
+            T.i32(),
+            [cutlass.Int16(a).ir_value(loc=loc, ip=ip)],
+            "cvt.rn.bf16x2.ue8m0x2 $0, $1;",
+            "=r,h",  # r = 32-bit dest (bf16x2), h = 16-bit src (ue8m0x2)
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+        )
+    )
+
