+         ((uint32_t)__nv_cvt_bfloat16raw2_to_fp4x2(__nv_bfloat162_raw{bfloat16_t(a[2]).storage, bfloat16_t(a[3]).storage}, __NV_E2M1, cudaRoundNearest) << 8);
