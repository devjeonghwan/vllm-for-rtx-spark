+
+    @cute.kernel
+    def kernel(
+        self,
+        mQ: Optional[cute.Tensor],
+        mQv: cute.Tensor,
+        mK: Optional[cute.Tensor],
+        mV: cute.Tensor,
+        mVt: cute.Tensor,
