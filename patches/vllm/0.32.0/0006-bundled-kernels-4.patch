+
+        # ==== Set up P smem -> gmem tma store ====
+
+        # S<3,4,3> o 0 o ((8,8),(64,2),(1,1)):((64,512),(1,4096),(0,0))
+        sP_layout_out = sm100_utils.make_smem_layout_epi(
