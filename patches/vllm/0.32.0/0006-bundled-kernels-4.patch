+    if varlen_batch_idx is not None:
+        if virtual_batch_idx is not None:
+            raise ValueError(
+                "virtual_batch_idx and varlen_batch_idx cannot both be provided"
+            )
+        virtual_batch_idx = varlen_batch_idx
