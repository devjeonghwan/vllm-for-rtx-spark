+            tVsV_f8_frg = tVsV_f8[None, i, None]
+            tVrV_f8_frg = tVrV_f8[None, i, None]
+            tVsV_f16_frg = tVsV_f16[None, i, None]
+            # tVrV_f16_frg = tVrV_f16[None, i, None]
+            tVrV_f16_frg = cute.make_fragment_like(tVsV_f16_frg)
