+  using result_type = Array<cutlass::tfloat32_t, N>;
+  using source_type = Array<cutlass::float_e2m1_t, N>;
+  static FloatRoundStyle const round_style = Round;
+
+  CUTLASS_HOST_DEVICE
+  static result_type convert(source_type const & source) {
