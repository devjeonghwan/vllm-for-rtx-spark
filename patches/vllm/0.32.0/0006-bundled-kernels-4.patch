+        num_splits,
+        pack_gqa,
+        deterministic,
+        score_mod,
+        score_mod_bwd,
+        mask_mod,
+        aux_tensors,
+        aux_scalars,
+        block_sparse_tensors,
+        block_sparse_tensors_bwd,
+        return_lse,
+        out,
+        output_scale,
+    )
