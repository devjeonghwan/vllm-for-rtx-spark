@@ -0,0 +1,19 @@
+from abc import ABC, abstractmethod
+
+
+class Layout(ABC):
+
+    def __init__(self, shape) -> None:
+        self.initial_shape = shape
+
+    @abstractmethod
+    def swizzle_data(self, data):
+        pass
+
+    @abstractmethod
+    def unswizzle_data(self, data):
+        pass
+
+    @abstractmethod
+    def swizzle_block_shape(self, block_shape):
+        pass
diff --git a/vllm/third_party/triton_kernels/tensor_details/layout_details/blackwell_scale.py b/vllm/third_party/triton_kernels/tensor_details/layout_details/blackwell_scale.py
