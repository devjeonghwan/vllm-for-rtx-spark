+#pragma once
+
+namespace cute::TMEM {
+
+// TMEM geometry per SM (rows constant across all tcgen05 architectures).
+static constexpr int Sm100TmemCapacityRows    = 128;
+static constexpr int Sm100TmemCapacityColumns = 512;
+static constexpr int Sm107TmemCapacityColumns = 576;
+// Compile-time TMEM column capacity for the current compilation target.
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ == 1070)
+static constexpr int TargetTmemCapacityColumns = Sm107TmemCapacityColumns;
+#elif defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 1000) && (__CUDA_ARCH__ < 1200)
+static constexpr int TargetTmemCapacityColumns = Sm100TmemCapacityColumns;
+#else
+static constexpr int TargetTmemCapacityColumns = 0;
+#endif
+
+// Maximum TMEM capacity in bits for the current compilation target.
+static constexpr int TargetTmemCapacityBits = Sm100TmemCapacityRows * TargetTmemCapacityColumns * 32;
+
+} // namespace cute::TMEM
