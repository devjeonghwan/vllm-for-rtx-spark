+
+namespace detail {
+template<class InputLayoutAtom_, class ComputeLayoutAtom_>
+struct Sm100CollectiveMmaComplexLayoutAtomType {
+  using InputLayoutAtom = InputLayoutAtom_;
+  using ComputeLayoutAtom = ComputeLayoutAtom_;
