+//
+// Equality operators
+//
+
+namespace detail {
+
+template <class TupleA, class TupleB, size_t... I>
+CUTE_HOST_DEVICE constexpr
+auto
+equal_impl(TupleA const& a, TupleB const& b, index_sequence<I...>)
+{
+  return (cute::true_type{} && ... && (get<I>(a) == get<I>(b)));
+}
