+{
+  using ThrID = Layout<_2>;
+  using ValID = typename Copy_Traits<SM100_UTCCP_128dp256bit_1cta>::ValID;
+  using SrcLayout = Layout<Shape <_2, _32768>,
+                           Stride<_0, _1>>;
+  using DstLayout = Layout<Shape <_2, _32768>,
+                           Stride<_0, _1>>;
+  using RefLayout = DstLayout;
+};
+
