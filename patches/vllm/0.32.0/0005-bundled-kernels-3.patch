+/// Fused multiply-add
+template <typename A, typename B = A, typename C = A>
+struct multiply_add {
+  CUTLASS_HOST_DEVICE
+  C operator()(A const &a, B const &b, C const &c) const {
+    return C(a) * C(b) + c;
+  }
+};
