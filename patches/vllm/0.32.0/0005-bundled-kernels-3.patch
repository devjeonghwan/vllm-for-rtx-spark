+                       Stride<TMEM::DP_b, _1>>;
+  using SrcLayout = Layout<Shape<_1, _16384>,
+                           Stride<_0, _1>>;
+  using DstLayout = Layout<Shape<_1, _16384>,
+                           Stride<_0,_1>>;
+  using RefLayout = DstLayout;
+};
