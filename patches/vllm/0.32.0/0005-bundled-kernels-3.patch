+  using SrcLayout = Layout<Shape <_2,Shape <_4, _256>>,
+                           Stride<_0,Stride<_32,_128>>>;
+  using DstLayout = Layout<Shape <_2,Shape <_4, _256>>,
+                           Stride<_0,Stride<_32,_128>>>;
+  using RefLayout = DstLayout;
+};
+
+////////////////////////////////////////////////////////////////////////////////////////////////////
