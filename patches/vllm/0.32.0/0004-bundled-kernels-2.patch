+                        tmem_tiled_copy,
+                        tTR_tAcc_staged[(None, None, None, None, acc_full.index)],
+                        rScores,
+                    )
+                    cute.arch.fence_view_async_tmem_load()
+                    for query_idx in cutlass.range_constexpr(self.num_queries):
