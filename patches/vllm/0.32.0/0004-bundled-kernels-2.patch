+    k_min_len = topk * BLK_KV
+    if check_empty:
+        k_min_len = max(k_min_len, 2 * BLK_KV)
+    k_lens = tuple(max(length, k_min_len) for length in k_lens)
+    inputs = _build_sparse_inputs(
+        q_lens=q_lens,
+        k_lens=k_lens,
+        head_kv=head_kv,
+        qhead_per_kv=qhead_per_kv,
+        dim=128,
