+                    tma_atom_Q,
+                    tQgQ[(None, 0, 0)],
+                    tQsQ,
+                    tma_bar_ptr=q_empty.barrier,
+                )
+                global_page += segment_pages
+                pages_remaining -= segment_pages
+                while (
+                    current_batch < batch_size - Int32(1)
+                    and mScheduler[current_batch + 1] <= global_page
+                ):
+                    current_batch += Int32(1)
