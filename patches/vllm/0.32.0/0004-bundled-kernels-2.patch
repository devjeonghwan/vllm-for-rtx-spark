+        load_wg_barrier,
+        num_q_groups: Int32,
+        count_raw: Int32,
+        has_work: Int32,
+        head_kv_idx: Int32,
+        row_start: Int32,
+        q_batch_offset: Int32,
+        num_heads_kv: Int32,
+    ):
+        tidx = cute.arch.thread_idx()[0]
+        q_load_thread_base = Int32(self.q_load_warp_base * cute.arch.WARP_SIZE)
+        group_tidx = tidx - q_load_thread_base
