+/////////////////////////////////////////////////////////////////////////////////////////////////
+//
+// Partial specializations for float <=> cutlass::half_t
+//
+/////////////////////////////////////////////////////////////////////////////////////////////////
+
+/// Partial specialization for float <= cutlass::half_t
+template <FloatRoundStyle Round>
+struct NumericConverter<float, cutlass::half_t, Round> {
+
+  using result_type = float;
