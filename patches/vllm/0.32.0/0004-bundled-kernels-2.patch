+        L1_SHAPE_N, L1_SHAPE_K,
+        L2_SHAPE_N, L2_SHAPE_K,
+        kNumExpertsPerRank,
+        kNumSMs, kNumRanks,
+        kNumRingBlocks,
+        kNumSharedExperts,
