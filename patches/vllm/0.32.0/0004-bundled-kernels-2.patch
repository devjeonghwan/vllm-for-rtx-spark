+                        (self.n_block_size, self.head_dim // 2),
+                        (None, 0),
+                    )
+                    src_idx = Int32(0)
+                else:
+                    mK_cur = cute.domain_offset(
+                        (k_batch_offset, 0),
+                        mK[None, None, head_kv_idx],
+                    )
+                    gK = cute.local_tile(
+                        mK_cur,
+                        (self.n_block_size, self.head_dim // 2),
+                        (None, 0),
+                    )
+                    src_idx = kv_block_idx
+                load_K_fn, _, _ = copy_utils.tma_get_copy_fn(
+                    tma_atom_K_fp4,
+                    0,
+                    cute.make_layout(1),
+                    gK,
+                    sKFp4,
+                )
+                load_K_fn(
