+                    tma_atom_Q,
+                    0,
+                    cute.make_layout(1),
+                    cute.group_modes(sQ_tma, 0, 2),
+                    cute.group_modes(
+                        cute.flat_divide(
+                            cute.domain_offset((0, q_row), mQ_krb),
+                            (self.head_dim, self.num_queries),
+                        ),
+                        0,
+                        2,
+                    ),
+                )
