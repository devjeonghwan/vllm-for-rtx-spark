+
+CUTLASS_HOST_DEVICE
+half_t& operator++(half_t & lhs) {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 530)
+  lhs = half_t(__hadd(lhs.to_half(), half_t(1.0f).to_half()));
