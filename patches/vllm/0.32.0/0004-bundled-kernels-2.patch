+                                tensor_map_sfa_ptr, &shared_storage.full_barriers[stage_idx],
+                                shared_storage.smem_sfa[stage_idx] + r * SF_BLOCK_M * (BLOCK_K / 64),
+                                sfa_m_idx, sfa_k_idx + r * (BLOCK_K / 64), 2);
