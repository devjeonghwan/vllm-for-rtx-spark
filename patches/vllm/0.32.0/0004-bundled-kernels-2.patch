+                      ElementC_, LayoutC_, arch::OpClassTensorOp, 2, Operator_
+                      > {
+  using Shape = Shape_;
+  using WarpShape = WarpShape_;
+  using InstructionShape = GemmShape<8, 8, 4>;
+  using ElementA = ElementA_;
