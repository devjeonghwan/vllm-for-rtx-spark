+
+    q_src = inputs["q"]
+    k_src = inputs["k"]
+    v_src = inputs["v"]
+    q2k = inputs["q2k"]
+    k2q_row_ptr = inputs["k2q_row_ptr"]
+    k2q_q_indices = inputs["k2q_q_indices"]
