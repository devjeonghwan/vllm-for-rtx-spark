+    MatrixShape<Shape::kM, Shape::kK>, 
+    ElementA, 
+    SmemLayoutA,
+    1,
+    SmemThreadMapA
+  >;
+  
+  /// Policy of iterator B
+  using IteratorThreadMapB = transform::PitchLinear2DThreadTileStripminedThreadMap<
+    layout::PitchLinearShape<Shape::kN, Shape::kK>,
+    kThreads,
+    layout::PitchLinearShape<4, 4>
+  >;
