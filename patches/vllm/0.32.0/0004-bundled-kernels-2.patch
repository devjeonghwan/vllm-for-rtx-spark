+            topk=topk,
+            blk_kv=blk_kv,
+            causal=causal,
+        )
+        k2q_row_ptr, k2q_q_indices, schedule = build_k2q_csr(
+            q2k,
+            cu_seqlens_q,
+            cu_seqlens_k,
+            blk_kv,
+            total_k=sum(k_lens),
+            max_seqlen_k=max(k_lens),
+            max_seqlen_q=max(q_lens),
