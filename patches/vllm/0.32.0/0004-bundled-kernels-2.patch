+            qhead_per_kv=qhead_per_kv,
+            return_schedule=True,
+        )
+
+    q = q_src.detach().clone()
+    k = k_src.detach().clone()
+    v = v_src.detach().clone()
+    return_temperature_lse = lse_temperature_scale is not None
+    result = sparse_atten_func(
+        q,
+        k,
+        v,
+        k2q_row_ptr,
+        k2q_q_indices,
+        topk,
+        blk_kv=blk_kv,
+        causal=causal,
