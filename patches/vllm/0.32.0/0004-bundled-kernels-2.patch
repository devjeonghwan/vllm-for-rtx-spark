+    @cute.jit
+    def _wg_load_q_gather4(
+        self,
+        mQ_2d: cute.Tensor,
+        mQ_gather4_desc: cute.Tensor,
+        mK2qQSplitIndices: cute.Tensor,
+        sQIdxMeta: cute.Tensor,
+        sQ: cute.Tensor,
