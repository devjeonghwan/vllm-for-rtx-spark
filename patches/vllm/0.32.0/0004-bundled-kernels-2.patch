+def _length_summary(values: list[int]) -> str:
+    if not values:
+        return "[]"
+    parts: list[str] = []
+    current = int(values[0])
+    count = 1
+    for value in values[1:]:
+        value = int(value)
+        if value == current:
+            count += 1
+        else:
+            parts.append(f"{count}x{current}" if count > 1 else str(current))
+            current = value
+            count = 1
+    parts.append(f"{count}x{current}" if count > 1 else str(current))
+    return " + ".join(parts)
