+template<typename T>
+struct has_unqualified_conj<
+    T,
+    decltype(static_cast<void>(conj(cutlass::platform::declval<T>())), void())
+  > : cutlass::platform::true_type
+{};
+
+template <typename T>
+constexpr bool has_unqualified_conj_v = has_unqualified_conj<T>::value;
