+                    with cute.arch.elect_one():
+                        cute.arch.mbarrier_arrive(mbar_k_ptr)
+
+            if warp_idx_in_wg == Int32(1):
+                if const_expr(self.v_fp8_to_bf16):
+                    if const_expr(self.paged_kv):
+                        mV_cur = tma_V[None, None, head_kv_idx, sPagedKvIdx[0]]
+                        gV = cute.local_tile(
+                            mV_cur,
