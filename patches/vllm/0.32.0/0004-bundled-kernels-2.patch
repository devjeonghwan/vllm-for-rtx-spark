+        tTR_cScores = thr_tmem_copy.partition_D(tCcScores)
+
+        if warp_idx == Int32(1):
+            current_batch = batch_idx
+            logical_page = logical_page_begin
+            global_page = global_page_begin
+            pages_remaining = num_pages
+            while pages_remaining > Int32(0):
