+    cu_page_offsets_ptr: cute.Pointer,
+    qo_offset_ptr: cute.Pointer,
+    problem_size: tuple,
+    stream: cuda.CUstream,
+):
+    key = (
+        "fp4_indexer_decode_packed_q_sm100",
+        fmt.name,
+        bool(causal),
