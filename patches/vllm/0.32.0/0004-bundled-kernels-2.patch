+def sts_32_bf16(
+    smem_ptr: cute.Pointer,
+    v0: Float32,
+    v1: Float32,
+    *,
+    loc=None,
+    ip=None,
+):
+    """Store two bf16 values to shared memory as one 32-bit transaction."""
+    llvm.inline_asm(
+        None,
+        [
+            smem_ptr.toint().ir_value(loc=loc, ip=ip),
+            Float32(v0).ir_value(loc=loc, ip=ip),
+            Float32(v1).ir_value(loc=loc, ip=ip),
