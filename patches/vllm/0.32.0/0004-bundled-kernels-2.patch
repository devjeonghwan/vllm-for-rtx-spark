+  }
+  
+  /// Computes the inverse of a 2-by-2 matrix given
+  /// the matrix's determinant
+  CUTLASS_HOST_DEVICE
+  Matrix inverse(Element det) const {
+    return Matrix(
+      data[3], -data[1],
+      -data[2], data[0]
+    ) * (Element(1) / det); 
+  }
+
+  /// Computes the inverse of a 2-by-2 matrix.
+  CUTLASS_HOST_DEVICE
+  Matrix inverse() const {
+    return inverse(determinant());
+  }
