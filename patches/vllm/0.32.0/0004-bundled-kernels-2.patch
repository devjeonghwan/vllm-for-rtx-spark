+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("run_build_k2q_csr", &run_build_k2q_csr,
+          "q2k -> k2q CSR build (sorted within row)",
+          pybind11::arg("q2k"),
+          pybind11::arg("cu_q"),
+          pybind11::arg("cu_k"),
+          pybind11::arg("row_ptr"),
+          pybind11::arg("q_idx"),
+          pybind11::arg("topk"),
+          pybind11::arg("blk_kv"),
+          pybind11::arg("total_rows"),
