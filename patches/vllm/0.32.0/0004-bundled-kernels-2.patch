+        "{\n"
+        ".reg .u32 sa;\n"
+        ".reg .b16 h0, h1;\n"
+        ".reg .b32 p0;\n"
+        "cvt.u32.u64 sa, $0;\n"
+        "cvt.rn.bf16.f32 h0, $1;\n"
+        "cvt.rn.bf16.f32 h1, $2;\n"
+        "mov.b32 p0, {h0, h1};\n"
+        "st.shared.b32 [sa], p0;\n"
+        "}\n",
+        "l,f,f",
+        has_side_effects=True,
+        is_align_stack=False,
+        asm_dialect=llvm.AsmDialect.AD_ATT,
+        loc=loc,
+        ip=ip,
+    )
