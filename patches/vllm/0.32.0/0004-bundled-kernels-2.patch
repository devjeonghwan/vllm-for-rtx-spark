+                                        query_idx % self.num_index_heads,
+                                        current_batch * query_length
+                                        + query_idx // self.num_index_heads,
+                                        logical_page,
+                                    ] = row_max * self.score_scale
+                    global_page += Int32(1)
+                    logical_page += Int32(1)
+                pages_remaining -= segment_pages
