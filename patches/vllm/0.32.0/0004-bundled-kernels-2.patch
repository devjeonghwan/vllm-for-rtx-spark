+
+ private:
+  /// Underlying tile iterator
+  Base iterator_;
+
+ public:
+  /// Default ctor constructs null iterator
+  CUTLASS_HOST_DEVICE
+  MmaVoltaTensorOpMultiplicandTileIterator() {}
+
+  /// Constructor from TensorRef
