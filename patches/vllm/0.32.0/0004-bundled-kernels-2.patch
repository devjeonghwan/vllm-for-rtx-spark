+            ],
+            "{\n"
+            ".reg .b16 h0, h1;\n"
+            "cvt.rn.satfinite.e4m3x2.f32 h0, $2, $1;\n"
+            "cvt.rn.satfinite.e4m3x2.f32 h1, $4, $3;\n"
+            "mov.b32 $0, {h0, h1};\n"
+            "}\n",
