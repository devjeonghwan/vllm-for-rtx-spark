+
+  using DispatchPolicy = MainloopSm103ArrayTmaUmmaWarpSpecializedBlockScaled<
+                          LoadABPipelineStageCount,
+                          LoadSFPipelineStageCount,
+                          SchedulerPipelineStageCount,
+                          AccumulatorPipelineStageCount,
+                          ClusterShape,
+                          PrefetchType>;
