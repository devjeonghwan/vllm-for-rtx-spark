+                                const uint32_t col = warp_idx_in_wg * 8 + k * 4 + lane_idx / 8;
+                                auto dst = reinterpret_cast<uint8_t*>(shared_storage.smem_d.l1[epilogue_wg_idx][tma_stage_idx]) +
